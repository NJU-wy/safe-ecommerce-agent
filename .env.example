# OpenAI 兼容 API Key（请勿填写真实密钥后提交）
OPENAI_API_KEY=your_api_key

# 阿里云百炼北京地域 OpenAI 兼容地址
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 模型配置
MODEL_NAME=qwen3.7-plus
TEMPERATURE=0.7
MAX_RESPONSE_TOKENS=600

# MCP 配置
MCP_ENABLED=false
MCP_SERVER_URL=http://127.0.0.1:9123/mcp

# Multi-Agent 配置
MULTI_AGENT_ENABLED=false

# Memory 配置
MEMORY_ENABLED=true
MEMORY_DIR=app/sessions/memory
MEMORY_USER_ID=default
MAX_LTM_FACTS=50

# Skill 配置
SKILLS_ENABLED=true
SKILLS_DIR=app/agent/skills/definitions

# Evaluation 配置
EVAL_DATASET_PATH=app/evaluation/cases.json
EVAL_USE_JUDGE=true
EVAL_PASS_THRESHOLD=0.6

# RAG 配置
# 无需额外 Embedding API 时使用本地确定性向量；
# OpenAI API 可继续使用 text-embedding-3-small。
EMBEDDING_MODEL=local-hash-embedding-v1
KB_DIR=app/agent/rag/knowledge
# 向量后端：numpy（手写余弦，教学透明）/ chroma（向量数据库，生产代表）
RAG_BACKEND=numpy
# NumpyBackend 索引文件
KB_INDEX_PATH=app/sessions/kb_index.json
# ChromaBackend 持久化目录 + collection
CHROMA_PERSIST_DIR=app/sessions/chroma
CHROMA_COLLECTION=ecom_kb
